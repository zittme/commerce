<table name="commerce_item_option">
	<column name="option_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<column name="item_srl" type="bigint" notnull="notnull" index="idx_item_srl" />
	<column name="option_label" type="varchar" size="250" notnull="notnull" />
	<column name="option_type" type="varchar" size="10" notnull="notnull" default="basic" />
	<column name="combo" type="varchar" size="250" />
	<column name="price_add" type="bigint" notnull="notnull" default="0" />
	<column name="stock" type="int" notnull="notnull" default="0" />
	<column name="sku" type="varchar" size="80" />
	<column name="list_order" type="int" notnull="notnull" default="0" />
	<column name="low_stock" type="int" notnull="notnull" default="0" />
	<column name="low_stock_alerted" type="char" size="1" notnull="notnull" default="N" />
	<column name="status" type="char" size="1" notnull="notnull" default="Y" />
	<column name="regdate" type="char" size="14" />
</table>
