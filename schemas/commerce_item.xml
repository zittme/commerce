<table name="commerce_item">
	<column name="item_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<column name="seller_srl" type="bigint" notnull="notnull" default="0" index="idx_seller_srl" />
	<column name="category_srl" type="bigint" notnull="notnull" default="0" index="idx_category_srl" />
	<column name="seller_category_srl" type="bigint" notnull="notnull" default="0" index="idx_seller_category_srl" />
	<column name="item_name" type="varchar" size="250" notnull="notnull" />
	<column name="item_code" type="varchar" size="100" index="idx_item_code" />
	<column name="price" type="bigint" notnull="notnull" default="0" />
	<column name="sale_price" type="bigint" notnull="notnull" default="0" />
	<column name="effective_price" type="bigint" notnull="notnull" default="0" index="idx_effective_price" />
	<column name="stock" type="int" notnull="notnull" default="0" />
	<column name="use_stock" type="char" size="1" notnull="notnull" default="Y" />
	<column name="low_stock" type="int" notnull="notnull" default="0" />
	<column name="low_stock_alerted" type="char" size="1" notnull="notnull" default="N" />
	<column name="summary" type="varchar" size="250" />
	<column name="content" type="bigtext" />
	<column name="thumb" type="varchar" size="250" />
	<column name="images" type="text" />
	<column name="sale_start" type="char" size="14" />
	<column name="sale_end" type="char" size="14" />
	<column name="min_qty" type="int" notnull="notnull" default="0" />
	<column name="max_qty" type="int" notnull="notnull" default="0" />
	<column name="tax_type" type="varchar" size="10" notnull="notnull" default="taxable" />
	<column name="is_adult" type="char" size="1" notnull="notnull" default="N" />
	<column name="grade_discount" type="char" size="1" notnull="notnull" default="Y" />
	<column name="attrs" type="text" />
	<column name="has_options" type="char" size="1" notnull="notnull" default="N" />
	<column name="option_axes" type="text" />
	<column name="option_mode" type="varchar" size="10" notnull="notnull" default="single" />
	<column name="ship_fee_type" type="varchar" size="10" notnull="notnull" default="default" />
	<column name="ship_fee" type="bigint" notnull="notnull" default="0" />
	<column name="is_pin" type="char" size="1" notnull="notnull" default="N" />
	<column name="hidden_by_market" type="char" size="1" notnull="notnull" default="N" index="idx_hidden_by_market" />
	<column name="pin_daily_limit" type="int" notnull="notnull" default="0" />
	<column name="status" type="varchar" size="20" notnull="notnull" default="sale" index="idx_status" />
	<column name="is_recommend" type="char" size="1" notnull="notnull" default="N" index="idx_recommend" />
	<column name="is_new" type="char" size="1" notnull="notnull" default="N" />
	<column name="view_count" type="int" notnull="notnull" default="0" />
	<column name="buy_count" type="int" notnull="notnull" default="0" />
	<column name="list_order" type="bigint" notnull="notnull" default="0" index="idx_list_order" />
	<column name="regdate" type="char" size="14" index="idx_regdate" />
	<column name="last_update" type="char" size="14" />
</table>
