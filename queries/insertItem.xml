<query id="insertItem" action="insert">
	<tables>
		<table name="commerce_item" />
	</tables>
	<columns>
		<column name="item_srl" var="item_srl" notnull="notnull" />
		<column name="seller_srl" var="seller_srl" default="0" />
		<column name="category_srl" var="category_srl" default="0" />
		<column name="item_name" var="item_name" notnull="notnull" />
		<column name="item_code" var="item_code" />
		<column name="price" var="price" default="0" />
		<column name="sale_price" var="sale_price" default="0" />
		<column name="stock" var="stock" default="0" />
		<column name="use_stock" var="use_stock" default="Y" />
		<column name="summary" var="summary" />
		<column name="content" var="content" />
		<column name="thumb" var="thumb" />
		<column name="images" var="images" />
		<column name="sale_start" var="sale_start" />
		<column name="sale_end" var="sale_end" />
		<column name="min_qty" var="min_qty" default="0" />
		<column name="max_qty" var="max_qty" default="0" />
		<column name="tax_type" var="tax_type" default="taxable" />
		<column name="is_adult" var="is_adult" default="N" />
		<column name="has_options" var="has_options" default="N" />
		<column name="option_axes" var="option_axes" />
		<column name="option_mode" var="option_mode" />
		<column name="ship_fee_type" var="ship_fee_type" default="default" />
		<column name="ship_fee" var="ship_fee" default="0" />
		<column name="status" var="status" default="sale" />
		<column name="is_recommend" var="is_recommend" default="N" />
		<column name="is_new" var="is_new" default="N" />
		<column name="badges" var="badges" />
		<column name="list_order" var="list_order" default="0" />
		<column name="regdate" var="regdate" />
		<column name="last_update" var="last_update" />
	</columns>
</query>
