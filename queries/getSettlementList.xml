<query id="getSettlementList" action="select">
	<tables>
		<table name="commerce_settlement" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="seller_srl" var="seller_srl" filter="number" />
		<condition operation="equal" column="status" var="status" pipe="and" />
		<condition operation="more" column="period_end" var="period_from" pipe="and" />
		<condition operation="less" column="period_end" var="period_to" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="settlement_srl" order="desc" />
		<list_count var="list_count" default="30" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
