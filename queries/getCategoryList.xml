<query id="getCategoryList" action="select">
	<tables>
		<table name="commerce_category" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="is_active" var="is_active" />
	</conditions>
	<navigation>
		<index var="sort_index" default="list_order" order="asc" />
	</navigation>
</query>
