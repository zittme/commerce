<query id="getPromotionList" action="select">
	<tables>
		<table name="commerce_promotion" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="status" var="status" />
		<condition operation="equal" column="slug" var="slug" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="list_order" order="asc" />
		<list_count var="list_count" default="100" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
