<query id="getCouponList" action="select">
	<tables>
		<table name="commerce_coupon" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="status" var="status" />
	</conditions>
	<navigation>
		<index var="sort_index" default="coupon_srl" order="desc" />
		<list_count var="list_count" default="200" />
	</navigation>
</query>
