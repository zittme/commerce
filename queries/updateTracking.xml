<query id="updateTracking" action="update">
	<tables>
		<table name="commerce_tracking" />
	</tables>
	<columns>
		<column name="courier_code" var="courier_code" />
		<column name="invoice" var="invoice" />
		<column name="level" var="level" />
		<column name="status_name" var="status_name" />
		<column name="complete" var="complete" />
		<column name="details" var="details" />
		<column name="last_update" var="last_update" />
	</columns>
	<conditions>
		<condition operation="equal" column="tracking_srl" var="tracking_srl" notnull="notnull" />
	</conditions>
</query>
