<query id="insertCreditLog" action="insert">
	<tables>
		<table name="commerce_credit_log" />
	</tables>
	<columns>
		<column name="log_srl" var="log_srl" notnull="notnull" />
		<column name="member_srl" var="member_srl" notnull="notnull" />
		<column name="order_srl" var="order_srl" default="0" />
		<column name="amount" var="amount" default="0" />
		<column name="balance_after" var="balance_after" default="0" />
		<column name="type" var="type" notnull="notnull" />
		<column name="memo" var="memo" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
