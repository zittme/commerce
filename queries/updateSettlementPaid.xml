<query id="updateSettlementPaid" action="update">
	<tables>
		<table name="commerce_settlement" />
	</tables>
	<columns>
		<column name="status" var="status" notnull="notnull" />
		<column name="paid_date" var="paid_date" />
		<column name="memo" var="memo" />
	</columns>
	<conditions>
		<condition operation="equal" column="settlement_srl" var="settlement_srl" filter="number" required="true" />
		<condition operation="equal" column="status" var="from_status" pipe="and" required="true" />
	</conditions>
</query>
