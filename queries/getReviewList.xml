<query id="getReviewList" action="select">
	<tables>
		<table name="commerce_review" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="item_srl" var="item_srl" />
	</conditions>
	<navigation>
		<index var="sort_index" default="review_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
