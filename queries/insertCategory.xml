<query id="insertCategory" action="insert">
	<tables>
		<table name="commerce_category" />
	</tables>
	<columns>
		<column name="category_srl" var="category_srl" notnull="notnull" />
		<column name="parent_srl" var="parent_srl" default="0" />
		<column name="title" var="title" notnull="notnull" />
		<column name="list_order" var="list_order" default="0" />
		<column name="is_active" var="is_active" default="Y" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
