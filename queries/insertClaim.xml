<query id="insertClaim" action="insert">
	<tables>
		<table name="commerce_claim" />
	</tables>
	<columns>
		<column name="claim_srl" var="claim_srl" notnull="notnull" />
		<column name="order_srl" var="order_srl" notnull="notnull" />
		<column name="order_seller_srl" var="order_seller_srl" default="0" />
		<column name="member_srl" var="member_srl" default="0" />
		<column name="claim_type" var="claim_type" notnull="notnull" />
		<column name="reason" var="reason" />
		<column name="items" var="items" />
		<column name="status" var="status" default="requested" />
		<column name="refund_amount" var="refund_amount" default="0" />
		<column name="restock" var="restock" default="Y" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
