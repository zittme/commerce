<query id="updateOption" action="update">
	<tables>
		<table name="commerce_item_option" />
	</tables>
	<columns>
		<column name="option_label" var="option_label" />
		<column name="option_type" var="option_type" />
		<column name="combo" var="combo" />
		<column name="price_add" var="price_add" />
		<column name="stock" var="stock" />
		<column name="sku" var="sku" />
		<column name="list_order" var="list_order" />
	</columns>
	<conditions>
		<condition operation="equal" column="option_srl" var="option_srl" notnull="notnull" />
	</conditions>
</query>
