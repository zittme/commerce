<query id="getSellerByMember" action="select">
	<tables>
		<table name="commerce_seller" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" filter="number" required="true" />
	</conditions>
	<navigation>
		<index var="sort_index" default="seller_srl" order="desc" />
	</navigation>
</query>
