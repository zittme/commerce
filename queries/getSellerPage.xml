<query id="getSellerPage" action="select">
	<tables>
		<table name="commerce_seller" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="more" column="member_srl" var="member_min" filter="number" default="1" />
		<condition operation="equal" column="status" var="status" pipe="and" />
		<group pipe="and">
			<condition operation="like" column="shop_name" var="search_keyword" />
			<condition operation="like" column="biz_name" var="search_keyword" pipe="or" />
			<condition operation="like" column="biz_no" var="search_keyword" pipe="or" />
		</group>
	</conditions>
	<navigation>
		<index var="sort_index" default="seller_srl" order="desc" />
		<list_count var="list_count" default="30" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
