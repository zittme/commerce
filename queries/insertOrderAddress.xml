<query id="insertOrderAddress" action="insert">
	<tables>
		<table name="commerce_order_address" />
	</tables>
	<columns>
		<column name="address_srl" var="address_srl" notnull="notnull" />
		<column name="order_srl" var="order_srl" notnull="notnull" />
		<column name="receiver_name" var="receiver_name" notnull="notnull" />
		<column name="receiver_phone" var="receiver_phone" />
		<column name="phone_cc" var="phone_cc" />
		<column name="country" var="country" default="KR" />
		<column name="zipcode" var="zipcode" />
		<column name="state" var="state" />
		<column name="city" var="city" />
		<column name="address1" var="address1" />
		<column name="address2" var="address2" />
		<column name="delivery_memo" var="delivery_memo" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
