<query id="getBrandList" action="select">
	<tables>
		<table name="commerce_brand" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="is_visible" var="is_visible" />
	</conditions>
	<navigation>
		<index var="sort_index" default="list_order" order="asc" />
		<list_count var="list_count" default="200" />
	</navigation>
</query>
