<query id="getOrderList" action="select">
	<tables>
		<table name="commerce_order" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="in" column="status" var="status_list" />
		<condition operation="more" column="regdate" var="from_date" pipe="and" />
		<condition operation="less" column="regdate" var="to_date" pipe="and" />
		<group pipe="and">
			<condition operation="like" column="orderer_name" var="search_keyword" />
			<condition operation="like" column="orderer_phone" var="search_keyword" pipe="or" />
			<condition operation="like" column="order_code" var="search_keyword" pipe="or" />
		</group>
	</conditions>
	<navigation>
		<index var="sort_index" default="order_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
